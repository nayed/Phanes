{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phanes",
  "mainBinaryName": "phanes",
  "version": "1.1.3",
  "identifier": "io.nayed.Phanes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Phanes",
        "width": 1440,
        "height": 900,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false,
        "transparent": true,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "Write and read markdown",
    "longDescription": "A desktop markdown editor and reader: write markdown on the left and see GitHub-style rendering on the right, inside a workspace folder.",
    "copyright": "Nayed Saïd Ali",
    "publisher": "Nayed Saïd Ali",
    "linux": {
      "deb": {
        "desktopTemplate": "linux/phanes.desktop",
        "files": {
          "/usr/share/icons/hicolor/scalable/apps/io.nayed.Phanes.svg": "../docs/icons/io.nayed.Phanes.svg",
          "/usr/share/icons/hicolor/symbolic/apps/io.nayed.Phanes-symbolic.svg": "../docs/icons/io.nayed.Phanes-symbolic.svg"
        }
      },
      "rpm": {
        "desktopTemplate": "linux/phanes.desktop",
        "files": {
          "/usr/share/icons/hicolor/scalable/apps/io.nayed.Phanes.svg": "../docs/icons/io.nayed.Phanes.svg",
          "/usr/share/icons/hicolor/symbolic/apps/io.nayed.Phanes-symbolic.svg": "../docs/icons/io.nayed.Phanes-symbolic.svg"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/icons/hicolor/scalable/apps/io.nayed.Phanes.svg": "../docs/icons/io.nayed.Phanes.svg",
          "/usr/share/icons/hicolor/symbolic/apps/io.nayed.Phanes-symbolic.svg": "../docs/icons/io.nayed.Phanes-symbolic.svg"
        }
      }
    }
  }
}
