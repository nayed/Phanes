{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phanes",
  "mainBinaryName": "phanes",
  "version": "0.1.0",
  "identifier": "io.nayed.Phanes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Phanes",
        "width": 1440,
        "height": 900,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false,
        "transparent": true,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
